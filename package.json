{
  "name": "helios",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Claude Code API Service",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run test/e2e",
    "lint": "eslint src test --ext .ts",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "seed-keys": "tsx scripts/seed-api-keys.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnandChowdhary/helios.git"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "claude",
    "ai",
    "api"
  ],
  "author": "Anand Chowdhary",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AnandChowdhary/helios/issues"
  },
  "homepage": "https://github.com/AnandChowdhary/helios#readme",
  "dependencies": {
    "@cloudflare/containers": "^0.0.31",
    "hono": "^4.11.10",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.18",
    "@cloudflare/workers-types": "^4.20260108.0",
    "@types/node": "^25.0.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.69.0"
  }
}
