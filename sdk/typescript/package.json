{
  "name": "@helios-sdk/typescript",
  "version": "0.1.0",
  "description": "TypeScript SDK for Helios Cloud Claude Code API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
